# ============================================================
#  微信云托管构建上下文 = backend/；此文件避免把无关/敏感内容打进镜像
# ============================================================

# ---- Python 虚拟环境 / 字节码 / 缓存 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.tmp/
.swc/

# ---- 密钥与本地配置：云托管用控制台「环境变量」注入，切勿进镜像 ----
.env
.env.*

# ---- 运行期数据：容器内自动重建，本地数据不应进镜像 ----
kb_data/
uploads/
*.db
*.sqlite3
ai_quiz_local.db

# ---- 测试与本地开发脚本 ----
tests/
start_backend.bat

# ---- Dockerfile 自身无需拷贝进镜像 ----
Dockerfile
.dockerignore
