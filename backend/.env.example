# ===== DeepSeek / OpenAI 兼容配置 =====
# 在 https://platform.deepseek.com 申请后填入
# 模型说明：官方已停用 deepseek-chat/deepseek-reasoner（2026-07-24），
# 现行模型：deepseek-flash（轻量主力）/ deepseek-v4-pro（旗舰）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：deepseek-flash 默认开启，但思考模式与结构化输出的强制 tool_choice 互斥
# （400 "Thinking mode does not support this tool_choice"），出题/研究链路依赖
# function calling，故必须保持 disabled
DEEPSEEK_THINKING=disabled

# ===== 联网研究（Tavily） =====
# 在 https://tavily.com 免费注册获取（1000 credits/月）；留空 = 研究阶段自动降级为纯模型出题
TAVILY_API_KEY=
# 研究总开关（紧急关断用）
RESEARCH_ENABLED=true
# 单任务工具/模型调用次数上限（agent middleware 护栏）
RESEARCH_MAX_TOOL_CALLS=6
RESEARCH_MAX_MODEL_CALLS=8
# 研究阶段总超时（秒）
RESEARCH_TIMEOUT=60
# 研究模型温度（事实性优先，低温度）
RESEARCH_TEMPERATURE=0.2
# max_results 参数上限 / 截断预算（字符）
RESEARCH_RESULTS_LIMIT=8
RESEARCH_PER_SOURCE_MAX_CHARS=2500
RESEARCH_TOOL_OUTPUT_MAX_CHARS=6000
RESEARCH_CONTEXT_MAX_CHARS=6000
# 研究产出缓存 TTL（秒）
RESEARCH_CACHE_TTL_SECONDS=900

# ===== 知识库 RAG（百炼 Embedding + Chroma） =====
# 在 https://bailian.console.aliyun.com 开通百炼后获取（开通后 90 天内 100 万 token 免费额度）
# 留空 = 知识库不可用（上传报错、勾选知识库出题时降级为联网+纯模型）
DASHSCOPE_API_KEY=
# 百炼 OpenAI 兼容接口地址与模型（text-embedding-v4 中文效果好，免费额度足）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 向量维度：64~2048，默认 1024
EMBEDDING_DIMENSIONS=1024
# 知识库总开关（紧急关断用）
KB_ENABLED=true
# Chroma 持久化目录（相对 backend 运行目录，重启不丢数据）
KB_PERSIST_DIR=kb_data
# 文本分块：块大小 / 相邻块重叠（字符数）
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50
# 单文档大小上限（MB）
KB_MAX_FILE_MB=10
# kb_search 默认检索条数
KB_TOP_K=4

# ===== 出题参数 =====
QUIZ_TEMPERATURE=0.4
QUIZ_TOP_P=0.9
QUIZ_MAX_TOKENS=1200
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ===== 报告参数 =====
REPORT_TEMPERATURE=0.5

# ===== 业务参数 =====
INPUT_MIN_LEN=2
INPUT_MAX_LEN=500
DEFAULT_QUESTION_COUNT=5
TASK_TTL_SECONDS=1800

# ===== 服务 =====
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO

# ===== MySQL =====
# SQLAlchemy 连接串。库需要先建好（例如 CREATE DATABASE ai_quiz CHARACTER SET utf8mb4;）
# 启动后会自动建表。格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/ai_quiz?charset=utf8mb4

# ===== 微信小程序 =====
# 微信公众平台 → 开发 → 开发管理 → 开发设置
# WECHAT_SECRET 留空时走开发兜底登录（不调 code2session），填入后切真实登录
WECHAT_APPID=
WECHAT_SECRET=

# ===== JWT（登录 Token）=====
# 请换成足够长的随机串，不要用下面的示例值上线
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_DAYS=30

# ===== 上传 =====
# 头像上传目录（相对于 backend 运行目录），对外经 /static 挂载
UPLOAD_DIR=uploads
